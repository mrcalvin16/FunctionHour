# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_************
CLERK_SECRET_KEY=sk_test_************

# Optional digital wallet issuance. Set these only in the server environment.
# Apple: create a Pass Type ID and signing certificate under your Apple Developer team.
# Store the PEM certificate/key and Apple WWDR intermediate certificate as base64.
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_WWDR_CERT_BASE64=
APPLE_WALLET_SIGNER_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_BASE64=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
# Google: approve a Wallet issuer, grant its service account access, and use its RSA private key.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
CLERK_JWT_ISSUER_DOMAIN=https://quiet-garfish-30.clerk.accounts.dev

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY=sk_test_************
STRIPE_WEBHOOK_SECRET=whsec_************
STRIPE_WEBHOOK_SHARED_SECRET=replace-with-a-long-random-server-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_************

# Convex (https://convex.dev)
NEXT_PUBLIC_CONVEX_URL=https://**********.convex.cloud
CONVEX_DEPLOYMENT=dev:upbeat-stoat-xxx
CONVEX_DEPLOY_KEY=upbeat-stoat-xxx

# OpenAI
OPENAI_API_KEY=sk-************

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000 # Change in production

# Transactional ticket delivery (verify functionhour.com with Resend)
RESEND_API_KEY=re_your_resend_api_key
TRANSACTIONAL_EMAIL_FROM=Function Hour <operations@functionhour.com>
